@echo off
set LLM_ENABLED=true
set LLM_BASE_URL=https://apie.zhisuaninfo.com/v1
set LLM_MODEL=Qwen3.6-35B-A3B
set LLM_MAX_TOKENS=8192
set LLM_TIMEOUT_SECONDS=180
set LLM_API_KEY=replace-with-your-key
set DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
set DASHSCOPE_MODEL=qwen3.6-35b-a3b
set DASHSCOPE_ENABLE_THINKING=true
set DASHSCOPE_API_KEY=replace-with-your-dashscope-key
rem Field judge requires start-local.ps1 -WithSidecar so OCR can build field-and-value evidence crops.
set FIELD_JUDGE_ENABLED=true
set FIELD_JUDGE_MODE=enforce
set FIELD_JUDGE_BASE_URL=https://token.zhisuaninfo.com/v1
set FIELD_JUDGE_MODEL=Qwen3.6-Flash
set FIELD_JUDGE_API_KEY=replace-with-your-field-judge-key
set FIELD_JUDGE_TIMEOUT_SECONDS=20
set FIELD_JUDGE_PASS_THRESHOLD=85
